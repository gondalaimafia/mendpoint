{
  "openapi": "3.0.3",
  "info": {
    "title": "Stripe API (flagship fixture)",
    "version": "2025-01-01"
  },
  "paths": {
    "/v1/charges": {
      "post": {
        "operationId": "PostCharges",
        "summary": "Create a charge",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["amount", "currency"],
                "properties": {
                  "amount": {
                    "type": "integer",
                    "description": "Amount in minor units (was amount_cents)"
                  },
                  "currency": { "type": "string" },
                  "customer": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "amount": { "type": "integer" },
                    "status": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/customers": {
      "get": {
        "operationId": "GetCustomers",
        "summary": "List customers",
        "parameters": [
          {
            "name": "starting_after",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "type": "object" } },
                    "has_more": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
