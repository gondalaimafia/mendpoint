{
  "openapi": "3.0.3",
  "info": {
    "title": "Twilio API (flagship fixture)",
    "version": "1.0.0"
  },
  "paths": {
    "/2010-04-01/Accounts/{AccountSid}/Messages.json": {
      "post": {
        "operationId": "CreateMessage",
        "summary": "Send an SMS",
        "parameters": [
          {
            "name": "AccountSid",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": ["To", "From", "Body"],
                "properties": {
                  "To": { "type": "string" },
                  "From": { "type": "string" },
                  "Body": {
                    "type": "string",
                    "description": "Message body text"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sid": { "type": "string" },
                    "status": { "type": "string" },
                    "body": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
