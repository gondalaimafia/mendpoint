{
  "openapi": "3.0.3",
  "info": {
    "title": "Meridian Payments API",
    "version": "2023-11-01",
    "description": "Meridian payments provider. Charges, refunds, and account balance."
  },
  "servers": [
    {
      "url": "https://api.meridian.example"
    }
  ],
  "tags": [
    {
      "name": "Charges"
    },
    {
      "name": "Refunds"
    },
    {
      "name": "Balance"
    }
  ],
  "paths": {
    "/v1/charges": {
      "post": {
        "operationId": "createCharge",
        "summary": "Create a charge",
        "tags": [
          "Charges"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChargeCreateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Charge created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Charge"
                }
              }
            }
          },
          "402": {
            "description": "Card declined",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listCharges",
        "summary": "List charges",
        "tags": [
          "Charges"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            }
          },
          {
            "name": "starting_at",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of charges",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChargeList"
                }
              }
            }
          }
        }
      }
    },
    "/v1/charges/{id}": {
      "get": {
        "operationId": "getCharge",
        "summary": "Retrieve a charge",
        "tags": [
          "Charges"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The charge",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Charge"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/charges/{id}/capture": {
      "post": {
        "operationId": "captureCharge",
        "summary": "Capture a previously authorized charge",
        "tags": [
          "Charges"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The captured charge",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Charge"
                }
              }
            }
          }
        }
      }
    },
    "/v1/refunds": {
      "post": {
        "operationId": "createRefund",
        "summary": "Refund a charge",
        "tags": [
          "Refunds"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefundCreateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Refund created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refund"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Charge": {
        "type": "object",
        "required": [
          "id",
          "object",
          "amount",
          "currency",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "ch_3Nk8s"
          },
          "object": {
            "type": "string",
            "enum": [
              "charge"
            ]
          },
          "amount": {
            "type": "integer",
            "description": "Amount in the minor unit of the currency."
          },
          "currency": {
            "type": "string",
            "example": "usd"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "succeeded",
              "failed",
              "refunded"
            ]
          },
          "captured": {
            "type": "boolean"
          },
          "created": {
            "type": "integer",
            "description": "Unix timestamp (seconds)."
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "ChargeCreateRequest": {
        "type": "object",
        "required": [
          "amount",
          "currency",
          "source"
        ],
        "properties": {
          "amount": {
            "type": "integer",
            "description": "Amount to charge in the minor unit."
          },
          "currency": {
            "type": "string",
            "example": "usd"
          },
          "source": {
            "type": "string",
            "description": "Tokenized payment instrument that funds the charge.",
            "example": "pm_card_visa"
          },
          "description": {
            "type": "string"
          },
          "capture": {
            "type": "boolean",
            "default": true
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "ChargeList": {
        "type": "object",
        "required": [
          "object",
          "data",
          "has_more"
        ],
        "properties": {
          "object": {
            "type": "string",
            "enum": [
              "list"
            ]
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Charge"
            }
          },
          "has_more": {
            "type": "boolean"
          }
        }
      },
      "Refund": {
        "type": "object",
        "required": [
          "id",
          "object",
          "charge",
          "amount",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "type": "string",
            "enum": [
              "refund"
            ]
          },
          "charge": {
            "type": "string"
          },
          "amount": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "succeeded",
              "failed"
            ]
          }
        }
      },
      "RefundCreateRequest": {
        "type": "object",
        "required": [
          "charge"
        ],
        "properties": {
          "charge": {
            "type": "string"
          },
          "amount": {
            "type": "integer"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "type",
              "code",
              "message"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
