{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git worktree*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr create*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh issue comment*)",
      "Bash(npm test*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run build*)",
      "Bash(npm run lint*)",
      "Bash(npx tsc*)"
    ],
    "deny": [
      "Read(./**/.env*)",
      "Read(./data/**)",
      "Bash(gh pr merge*)",
      "Bash(gh pr review*)",
      "Bash(gh pr close*)",
      "Bash(gh issue delete*)",
      "Bash(env)",
      "Bash(printenv*)",
      "Bash(Get-ChildItem Env:*)"
    ]
  }
}
