# Customer production profile
NODE_ENV=production
MENDPOINT_DEPLOYMENT_PROFILE=customer
API_AUTH=required
API_PORT=3001
API_HOST=127.0.0.1
MENDPOINT_DATA_DIR=/app/data
MENDPOINT_REPOS_DIR=/workspace/repos
MENDPOINT_TENANT_ID=tenant_default
GRAPH_LEARN_DB=/app/data/graph-learn.sqlite
MENDPOINT_ALERTS_PATH=/app/data/alerts.jsonl

# Public origins
WEB_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
PUBLIC_API_URL=https://api.example.com
MENDPOINT_WEB_ALLOWED_ORIGINS=https://app.example.com

# GitHub delivery and signed webhooks
GITHUB_MODE=real
# Customer deployments require GitHub App authorization. A disposable private
# canary may instead set this to disposable_canary and provide one fine-grained
# PAT plus the single MENDPOINT_TENANT_ID above.
MENDPOINT_DEPLOYMENT_CLASS=customer
MENDPOINT_FEED_POLLING_ENABLED=1
POLL_LOCAL_ONLY=0
MENDPOINT_PILOT_SEED=0
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
# Stable GitHub numeric account ID to tenant map. Login keyed legacy mappings are rejected.
GITHUB_APP_ACCOUNT_TENANT_BINDINGS={}

# Bootstrap the API key from the API container before starting the web service.
MENDPOINT_API_KEY=
MENDPOINT_WEB_ACCESS_TOKEN=
# Distinct 32 byte base64url or 64 character hexadecimal key for encrypted applications.
MENDPOINT_APPLICATION_DATA_KEY=
MENDPOINT_API_URL=http://api:3001
MENDPOINT_WORKER_HEARTBEAT_PATH=/app/data/worker-heartbeat.json
MENDPOINT_WORKER_HEARTBEAT_MAX_AGE_MS=30000

# Production Fly verification is fail closed unless the image is immutable and
# the worker can verify a fresh protected egress acceptance receipt. Generate
# the receipt only after both the outbound denial and local execution probes pass.
MENDPOINT_SANDBOX_KIND=fly_machines
MENDPOINT_SANDBOX_FLY_APP=mendpoint-sandbox
MENDPOINT_SANDBOX_FLY_IMAGE=registry.fly.io/mendpoint-sandbox@sha256:<64-lowercase-hex>
MENDPOINT_SANDBOX_FLY_TOKEN=
MENDPOINT_SANDBOX_EGRESS_ATTESTATION_BASE64=
MENDPOINT_SANDBOX_EGRESS_ATTESTATION_PUBLIC_KEY_SPKI_BASE64=
MENDPOINT_SANDBOX_EGRESS_ATTESTATION_KEY_ID=sandbox-egress-key-1
MENDPOINT_SANDBOX_EGRESS_ATTESTATION_MIN_SCHEMA=2026-08-19.v2
MENDPOINT_SANDBOX_EGRESS_POLICY_DIGEST=sha256:<64-lowercase-hex>

# Optional delegated PR acceptance verification. This remains off until the
# verifier and candidate producer principals exist for the tenant. The worker
# reconstructs the sealed source and candidate, then runs both commands only in
# the protected Fly sandbox above. Keep the receipt secret distinct from every
# sandbox, backup, model, and application key.
MENDPOINT_DELEGATED_PR_VERIFICATION_ENABLED=0
# MENDPOINT_DELEGATED_PR_CANDIDATE_AUTHORITY_ID=
# MENDPOINT_DELEGATED_PR_VERIFIER_AUTHORITY_ID=
# MENDPOINT_DELEGATED_PR_VERIFIER_AUTHORITY_DIGEST=sha256:<64-lowercase-hex>
# MENDPOINT_DELEGATED_PR_EXECUTION_AUTHORITY_ID=
# MENDPOINT_DELEGATED_PR_RECEIPT_SECRET=
# MENDPOINT_DELEGATED_PR_FAIL_TO_PASS_COMMAND=
# MENDPOINT_DELEGATED_PR_PASS_TO_PASS_COMMAND=
# MENDPOINT_DELEGATED_PR_TIMEOUT_MS=120000
# MENDPOINT_DELEGATED_PR_LEASE_MS=300000

# Optional enterprise OIDC. Memberships must be provisioned before access.
# OIDC_ISSUER=https://identity.example.com
# OIDC_AUDIENCE=mendpoint-api
# OIDC_JWKS_URI=https://identity.example.com/.well-known/jwks.json
# OIDC_CLIENT_ID=mendpoint-web
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://app.example.com/api/oidc/callback
# OIDC_TENANT_CLAIM=tenant_id
# OIDC_REQUIRED_AMR=mfa
# OIDC_ALLOWED_ACR=
# OIDC_MAX_TOKEN_AGE_SECONDS=3600
# A customer deployment declares its own readiness. "1" declares ready and boots
# ready only when every precondition (human identity, real repository delivery,
# sandbox egress attestation, model routing, isolated backup, single-machine
# binding) is met; "0" declares an honest not-ready hold. Leaving it unset or
# using any other value is indeterminate and fails closed at boot.
# MENDPOINT_CUSTOMER_READY=1

# Manual plan changes remain disabled until finance has approved contract pricing and tax policy.
# MENDPOINT_MANUAL_PLAN_CHANGES_ENABLED=0

# Application-consistent customer backup. Every durable SQLite store is
# explicit and every bundle is authenticated and encrypted. The output root
# must be an independently mounted durable target. Off-host replication,
# retention and orchestrator owner-termination evidence remain operator-owned.
MENDPOINT_BACKUP_SOURCE_ROOT=/app/data
MENDPOINT_BACKUP_OUTPUT_ROOT=/backup/mendpoint
MENDPOINT_BACKUP_FENCE_ROOT=/app/data/.backup-fence
MENDPOINT_BACKUP_EVIDENCE_PATH=/app/data/.backup-state/last-verified.json
MENDPOINT_BACKUP_STORAGE_CLASS=durable_isolated_mount
# Distinct 32 byte base64url or 64 character hexadecimal customer backup key.
MENDPOINT_BACKUP_KEY=
MENDPOINT_BACKUP_KEY_ID=customer-backup-key-v1
MENDPOINT_BACKUP_DATABASE_PATH=mendpoint.sqlite
MENDPOINT_BACKUP_GRAPH_PATH=graph-learn.sqlite
MENDPOINT_BACKUP_CHANGE_SOURCES_PATH=change-sources.sqlite
MENDPOINT_BACKUP_REGAUGE_CONTROL_PLANE_PATH=transformer-control-plane.sqlite
MENDPOINT_BACKUP_REGAUGE_PILOT_PATH=transformer-pilot.sqlite
# The artifact resource is the data root; backup inventory admits only the
# retained Warden and Transformer candidate/evidence subdirectories.
MENDPOINT_BACKUP_ARTIFACTS_PATH=.
MENDPOINT_BACKUP_CONFIGURATION_PATH=recovery-config.json
MENDPOINT_BACKUP_WAIT_TIMEOUT_MS=30000
# Restore always publishes to a new isolated target for operator validation.
MENDPOINT_RESTORE_BACKUP_ROOT=
MENDPOINT_RESTORE_TARGET_ROOT=/restore/mendpoint

# Runtime controls
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
POLL_INTERVAL_MS=5000
JOB_LEASE_MS=900000
# Customer mode requires a real nonlocal HTTPS feed and at least one observed
# successful schedule before deployment health becomes ready.
MENDPOINT_FEED_POLLING_ENABLED=1
# Require an approved per-repository verification profile before delivery.
MENDPOINT_VERIFY_FIRST=1
AGENTIC_REPAIR=1

# Optional LLM confirmation and repair
# LLM_CONFIRM=1
# LLM_CONFIRM_MODE=heuristic
# LLM_CONFIRM_MAX=12
# LLM_CONFIRM_MODEL=grok-3-mini
# OPENAI_API_KEY=
# XAI_API_KEY=
# XAI_API_BASE=https://api.x.ai/v1

# Optional allowlisted Warden model source. Every provider call reserves its
# configured worst case cost before dispatch and fails closed if accounting is unavailable.
# MENDPOINT_FETTLER_MODEL_SOURCE_ENABLED=0
# MENDPOINT_FETTLER_MODEL_SOURCE_TENANTS=tenant_default
# MENDPOINT_FETTLER_MODEL_PROVIDER=openai-compatible
# MENDPOINT_FETTLER_EXTERNAL_PROCESSING_ALLOWED=0
# MENDPOINT_FETTLER_MODEL_REGION=us-central
# MENDPOINT_FETTLER_MODEL_MAXIMUM_DATA_CLASSIFICATION=confidential
# Tenant and stable remote repository ID to source classification. Unmapped repositories fail closed.
# MENDPOINT_FETTLER_REPOSITORY_CLASSIFICATIONS={"tenant_default":{"123456789":"internal"}}
# MENDPOINT_FETTLER_MODEL_ESTIMATED_COST_USD=0.25
# MENDPOINT_FETTLER_MODEL_MAXIMUM_CALL_COST_USD=1.00
# MENDPOINT_MODEL_PROVIDER=muse-spark
# LLM_AGENT_MODEL=muse-spark-1.2
# LLM_AGENT_URL=https://models.example/v1

# Optional independent completion verifier. The first release accepts only
# offline or shadow rollout and never changes Fettler or Regauge behavior.
# DEEPSEEK_VERIFIER_ENABLED=false
# DEEPSEEK_API_KEY=
# MENDPOINT_AGENT_VERIFIER_ROLLOUT_MODE=shadow
# MENDPOINT_AGENT_VERIFIER_SCORING_MODE=nonthinking_logprobs
# MENDPOINT_AGENT_VERIFIER_EVALUATIONS=4
# MENDPOINT_AGENT_VERIFIER_PIVOTS=2
# MENDPOINT_AGENT_VERIFIER_MAXIMUM_CANDIDATES=5
# MENDPOINT_AGENT_VERIFIER_MAXIMUM_COST_USD=0.25
# MENDPOINT_AGENT_VERIFIER_TIMEOUT_MS=30000
# MENDPOINT_AGENT_VERIFIER_MAXIMUM_RETRIES=1
# MENDPOINT_AGENT_VERIFIER_PRINCIPAL_ID=
# MENDPOINT_AGENT_VERIFIER_GOVERNANCE_JSON={"schemaVersion":"2026-08-17.v1","entries":[]}
# MENDPOINT_AGENT_VERIFIER_PRICING_JSON={"version":"operator-price-version","currency":"USD","effectiveAt":"2026-08-17T00:00:00.000Z","inputPerMillion":0,"cachedInputPerMillion":0,"outputPerMillion":0}

# Enforced no external egress for model calls (self-hosted). Default
# external_allowed preserves current behavior. local_only rejects any model
# endpoint whose host is not private, loopback, link-local, or on the allowlist,
# both at boot and when the agent resolves the endpoint. Missing endpoint under
# local_only is allowed (heuristic-only, no egress). See
# docs/SELF_HOSTED_NO_EGRESS.md.
# MENDPOINT_MODEL_EGRESS=external_allowed
# MENDPOINT_MODEL_LOCAL_HOSTS=localhost,model.internal

# Experimental features
# MENDPOINT_EXPERIMENTAL=1
# MENDPOINT_FEATURES=transformer_bsg_campaigns
# Transformer remains unavailable unless an exact tenant and environment grant is installed.
# MENDPOINT_REGAUGE_ENVIRONMENT=staging
# MENDPOINT_REGAUGE_GATE={"schemaVersion":"2026-08-02.v1","tenantAllowlist":["tenant_default"],"environmentAllowlist":["staging"],"grants":[{"tenantId":"tenant_default","environment":"staging","boundaries":["api_control_plane","worker_action","ui","delivery"],"acceptanceEvidenceRefs":["acceptance:approved-pilot"],"productionDeliveryApprovalRefs":[]}]}
