# --- GA production (recommended) ---
# NODE_ENV=production
# API_AUTH=required
# CORS_ORIGINS=https://app.example.com
# RATE_LIMIT_MAX=120
# RATE_LIMIT_WINDOW_MS=60000
# MENDPOINT_DATA_DIR=./data

DATABASE_URL=file:./data/mendpoint.sqlite
API_PORT=3001
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
# API_AUTH=off          # dev default; production forces required if unset
GITHUB_MODE=mock
# GITHUB_TOKEN=   # or use `gh auth token` for Phase A real PRs
# GITHUB_OWNER=
# GITHUB_REPO=
# GITHUB_WEBHOOK_SECRET=

# Experimental features (not GA)
# MENDPOINT_EXPERIMENTAL=1
# MENDPOINT_FEATURES=transformer_bsg_campaigns

# Phase B — LLM confirm (medium-confidence only; never whole-repo)
# LLM_CONFIRM=1
# LLM_CONFIRM_MODE=heuristic   # offline CI without keys
# LLM_CONFIRM_MAX=12
# LLM_CONFIRM_MODEL=grok-3-mini
# OPENAI_API_KEY=
# XAI_API_KEY=
# XAI_API_BASE=https://api.x.ai/v1

