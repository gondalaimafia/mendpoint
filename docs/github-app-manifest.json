{
  "name": "Mendpoint",
  "url": "https://mendpoint-talal.fly.dev",
  "hook_attributes": {
    "url": "https://mendpoint-talal.fly.dev/webhooks/github",
    "active": true
  },
  "setup_url": "https://mendpoint-talal.fly.dev/github/setup",
  "description": "Mendpoint detects API impact and prepares reviewed migration pull requests. It never auto merges.",
  "public": false,
  "default_events": [
    "installation",
    "installation_repositories",
    "pull_request",
    "pull_request_review",
    "pull_request_review_comment",
    "push"
  ],
  "default_permissions": {
    "contents": "write",
    "pull_requests": "write",
    "metadata": "read",
    "checks": "read"
  }
}
