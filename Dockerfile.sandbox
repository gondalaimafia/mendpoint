# Mendpoint sandbox runtime — per-run Fly Machines microVM image.
#
# This is NOT the application image (see ./Dockerfile). It is the minimal,
# purpose-built image that the Fly Machines sandbox backend
# (packages/platform/src/fly-sandbox.ts) boots as an ephemeral Machine for a
# single verification run. Lifecycle: create Machine from this image -> upload
# ONLY the caller tenant's workspace files to /workspace -> exec one verification
# command via `/bin/sh -c` -> always destroy the Machine on teardown.
#
# Build/push is OPERATOR-ONLY and never runs automatically:
#     node scripts/build-sandbox-image.mjs --push
# See docs/SANDBOX_IMAGE.md for the tool-to-call-site map, build/push, rollback,
# and the security posture.

# Pinned by version tag; the operator additionally pins by @sha256 digest (the
# build script prints the resolved digest to record). node:22 satisfies the repo
# engines (package.json "engines.node": ">=22.5.0") and the active
# node-runtime-20-to-22 recipe family, whose verifiers assert the executing
# runtime major is 22.
FROM node:22.11.0-bookworm-slim

# --- Runtime dependencies -------------------------------------------------
# Each package maps to a real verification call site (see docs/SANDBOX_IMAGE.md):
#   git            tooling shelled out during verify assumes a git binary (npm
#                  git-dependencies, tests that read git state); repository
#                  sources are git-materialized upstream.
#   python3        the `pytest` / `python3 -m pytest` verification profile
#                  (packages/repair/src/verify.ts) and the Python fixtures.
#   python3-pytest makes the bare `pytest` command resolve on PATH.
#   python3-venv   isolated dependency installs for Python projects (PEP 668 on
#                  Debian blocks system-level pip installs).
#   python3-pip    package installs inside a venv.
#   ca-certificates TLS trust for npm registry / PyPI fetches during verify
#                  (the slim base does not ship CA certs).
# Node + npm ship in the base image; npm drives vitest / jest through the
# project's own `npm test` / `npm run build|typecheck|lint` scripts.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
      git \
      python3 \
      python3-pytest \
      python3-venv \
      python3-pip \
      ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Expose python3 as `python` for verifiers that invoke the unversioned name.
RUN ln -sf /usr/bin/python3 /usr/local/bin/python

# --- Non-root workspace ---------------------------------------------------
# The base image ships an unprivileged `node` user (uid 1000). Tenant files are
# uploaded to /workspace; own it by that user and drop privileges. No secrets,
# credentials, or network configuration are baked into the image.
ENV NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_INPUT=1
RUN mkdir -p /workspace && chown -R node:node /workspace
WORKDIR /workspace
USER node

# Provenance only — no sensitive metadata.
LABEL org.opencontainers.image.title="mendpoint-sandbox" \
      org.opencontainers.image.description="Ephemeral per-run verification sandbox for Mendpoint Fly Machines" \
      org.opencontainers.image.source="https://github.com/mendpoint/mendpoint"

# Keep the Machine's main process alive so the sandbox can exec the verification
# command against a "started" Machine; the adapter destroys the Machine on
# teardown. The exec'd verification command overrides this per run.
CMD ["sleep", "infinity"]
