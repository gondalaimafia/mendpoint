# Baseline: every text file is committed and checked out as LF, so digest-pinned
# files (package-lock.json, tsconfig.base.json, .github/workflows/ci.yml, ...)
# hash identically on a Windows checkout with git's default core.autocrlf=true.
# Binary files are auto-detected and left untouched. The unconditional rules
# below deliberately override this heuristic for paths where "couldn't determine"
# must never silently mean "don't normalize".
* text=auto eol=lf

# Unconditional LF normalization. These paths do not get a heuristic vote: they
# are always treated as text and always checked out LF (kept from main; do not
# downgrade to text=auto).
.gitattributes text eol=lf
*.sh text eol=lf
docs/website-upload/** text eol=lf
apps/worker/src/delegated-pr-verification-job.ts text eol=lf
apps/worker/src/delegated-pr-verification-job.test.ts text eol=lf
packages/pipeline/src/delegated-pr-verification-operation.ts text eol=lf
packages/pipeline/src/delegated-pr-verification-operation.test.ts text eol=lf

# These TypeScript sources embed a literal NUL byte in a key-separator template
# literal (e.g. `${name}\0${JSON.stringify(attributes)}`), so `text=auto`
# classifies them binary and skips normalization, letting CRLF re-enter silently.
# Pin them to text/LF explicitly so the heuristic cannot opt them out. Changing
# the separator would alter key derivation, so the attribute route is used here.
packages/ops/src/telemetry.ts text eol=lf
packages/platform/src/router-adaptive.ts text eol=lf
packages/transformer/src/recipe.ts text eol=lf
apps/worker/src/transformer-learning-producer.ts text eol=lf
evals/context-benchmark/live-arm.ts text eol=lf

# These docs intentionally opt out of text handling (treated as binary).
docs/authority/Mendpoint_CODEX_Change_Graph_Intelligence_Prompt.md -text
docs/authority/Codex_Master_Prompt_Integrate_Graphify_Into_the_Mendpoint_Change_Graph.md -text
